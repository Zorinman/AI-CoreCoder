# Every configured model uses this same field set. MODEL and API_KEY are required.
# backend: openai_compatible | litellm. provider is a free supplier label.
CORECODER_PRIMARY_MODEL=gpt-5.4-mini
CORECODER_PRIMARY_API_KEY=
CORECODER_PRIMARY_BACKEND=openai_compatible
CORECODER_PRIMARY_PROVIDER=openai
CORECODER_PRIMARY_BASE_URL=
CORECODER_PRIMARY_TEMPERATURE=0
CORECODER_PRIMARY_MAX_TOKENS=4096

# Process-level limits
CORECODER_MAX_CONTEXT_TOKENS=128000
CORECODER_MAX_COST_USD=

# Optional fallback 1. Uncomment every line and provide its API key to enable it.
# CORECODER_FALLBACK_1_MODEL=deepseek-v4-flash
# CORECODER_FALLBACK_1_API_KEY=
# CORECODER_FALLBACK_1_BACKEND=openai_compatible
# CORECODER_FALLBACK_1_PROVIDER=deepseek
# CORECODER_FALLBACK_1_BASE_URL=https://api.deepseek.com/v1
# CORECODER_FALLBACK_1_TEMPERATURE=0
# CORECODER_FALLBACK_1_MAX_TOKENS=4096

# Optional fallback 2. Indexes must be consecutive and start at 1.
# CORECODER_FALLBACK_2_MODEL=anthropic/claude-haiku-4-5
# CORECODER_FALLBACK_2_API_KEY=
# CORECODER_FALLBACK_2_BACKEND=litellm
# CORECODER_FALLBACK_2_PROVIDER=anthropic
# CORECODER_FALLBACK_2_BASE_URL=
# CORECODER_FALLBACK_2_TEMPERATURE=0
# CORECODER_FALLBACK_2_MAX_TOKENS=4096
